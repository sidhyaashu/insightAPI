# ============================================================
# InsightAPI AI — Root Environment Configuration
# All services + client read from this single file.
# Copy to .env and fill in real values. NEVER commit .env
# ============================================================

# --- App Meta ---
APP_NAME="InsightAPI AI"
APP_ENV=development          # development | staging | production
APP_URL=http://localhost
API_V1_STR=/api/v1
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://app.insightapi.com

# --- AI / LLM Multi-Provider Configuration ---
# Active Provider: "auto" | "azure" | "gemini" | "openai" | "anthropic" | "local"
# When set to "auto", system automatically resolves credentials in priority order:
# Azure Foundry -> Google Gemini -> OpenAI -> Anthropic -> Local Ollama
LLM_PROVIDER=auto

# 1. Azure OpenAI / Microsoft AI Foundry
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_SMART=gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT_VISION=gpt-4.1-mini

# 2. Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash
GEMINI_MODEL_FAST=gemini-3.7-flash
GEMINI_MODEL_SMART=gemini-3.7-flash
GEMINI_MODEL_VISION=gemini-3.7-flash

# 3. Standard OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_SMART=gpt-4o
OPENAI_MODEL_VISION=gpt-4o-mini

# 4. Anthropic Claude
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-7-sonnet-20250219
ANTHROPIC_MODEL_FAST=claude-3-5-haiku-20241022
ANTHROPIC_MODEL_SMART=claude-3-7-sonnet-20250219
ANTHROPIC_MODEL_VISION=claude-3-7-sonnet-20250219

# 5. Ollama / Local (OpenAI-Compatible Server)
LOCAL_OPENAI_BASE_URL=http://localhost:11434/v1
LOCAL_OPENAI_API_KEY=ollama
LOCAL_OPENAI_MODEL=deepseek-r1:8b
LOCAL_OPENAI_MODEL_FAST=llama3.2:3b
LOCAL_OPENAI_MODEL_SMART=deepseek-r1:8b
LOCAL_OPENAI_MODEL_VISION=llava:7b

# --- Database (shared Postgres instance) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=insightapi
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432

# --- Redis Keys & Service Prefixes ---
REDIS_HOST=redis
REDIS_PORT=6379
GATEWAY_SERVICE_REDIS_PREFIX="insightapi:gateway:"
CORE_SERVICE_REDIS_PREFIX="insightapi:core:"
AGENT_SERVICE_REDIS_PREFIX="insightapi:agent:"

# --- JWT (Core Service + Gateway) ---
JWT_SECRET_KEY=your_long_random_jwt_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OAuth — GitHub ---
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here

# --- OAuth — Google ---
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Shared OAuth redirect URI (must match app URLs in OAuth provider settings)
OAUTH_REDIRECT_URI=http://localhost/api/auth/callback

# --- Stripe (inside Core Service) ---
STRIPE_SECRET_KEY=your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret_here
STRIPE_PRICE_STARTER=price_starter_placeholder
STRIPE_PRICE_PRO=price_pro_placeholder
STRIPE_PRICE_ENTERPRISE=price_enterprise_placeholder

# --- Agent Service ---
MAX_CRAWL_PAGES=15
CRAWL_TIMEOUT_SECONDS=300
RESPECT_ROBOTS_TXT=true
MIN_DOMAIN_DELAY_MS=500
FREE_TIER_DAILY_QUERIES=1

# --- Internal Service Communication ---
CORE_SERVICE_URL=http://core-service:8001
AGENT_SERVICE_URL=http://agent-service:8002
GATEWAY_SECRET=your_internal_gateway_secret_here

# --- ngrok Tunneling ---
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your_custom_ngrok_domain_here

# ============================================================
# NEXT_PUBLIC_* — Client-Side (baked at Next.js build time)
# These are safe to expose to the browser (no secrets here)
# ============================================================
NEXT_PUBLIC_APP_NAME="InsightAPI AI"
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_API_BASE_URL=http://localhost/api
NEXT_PUBLIC_WS_BASE_URL=ws://localhost/ws
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here
NEXT_PUBLIC_APP_ENV=development
